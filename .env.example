# Copie este arquivo para .env e preencha com seu Access Token de teste/produção.
# Nunca publique o token no HTML, GitHub ou navegador.
MERCADOPAGO_TOKEN=APP_USR-seu-access-token-aqui

# Segredo de assinatura (Webhook secret) gerado em Mercado Pago > Sua integração > Webhooks.
# Não é o Client Secret e nunca deve ser enviado ao navegador.
MERCADOPAGO_WEBHOOK_SECRET=seu-segredo-de-assinatura-aqui

# Tempo de validade do Pix em minutos (padrão: 30; permitido: 10 a 1440).
PIX_EXPIRATION_MINUTES=30

# Em hospedagem, aponte para um volume persistente. Localmente, o padrão é ./clientes.db.
# DATABASE_PATH=/caminho/do/volume/clientes.db
